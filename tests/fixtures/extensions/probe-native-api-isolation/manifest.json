{
  "manifest_version": 3,
  "name": "Bowser native API isolation fixture",
  "version": "0.0.1",
  "description": "Disposable loopback effects and native query provenance; no user data.",
  "key": "",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
