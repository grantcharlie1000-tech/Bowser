{
  "manifest_version": 3,
  "name": "Bowser native command grant probe",
  "version": "0.0.1",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "commands": {
    "bowser-native-probe": {
      "suggested_key": {
        "default": "Ctrl+Shift+X"
      },
      "description": "Disposable actual native command probe"
    }
  }
}
