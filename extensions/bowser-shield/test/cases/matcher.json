  { "name": "kind: frame is its own type", "rules": ["block host:a.example kind frame"], "url": "https://a.example/x", "site": "b.example", "type": "frame", "expect": "block", "line": 1 },

  { "name": "only: fires on a subdomain of the listed site", "rules": ["block host:a.example only shop.example"], "url": "https://a.example/x", "site": "www.shop.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "only: fires on the listed site", "rules": ["block host:a.example only shop.example"], "url": "https://a.example/x", "site": "shop.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "only: does not fire when the listed name is a prefix of another site", "rules": ["block host:a.example only shop.example"], "url": "https://a.example/x", "site": "shop.example.net", "type": "script", "expect": "pass" },
  { "name": "only: does not fire on a longer first label", "rules": ["block host:a.example only shop.example"], "url": "https://a.example/x", "site": "notshop.example", "type": "script", "expect": "pass" },
  { "name": "only: any of several sites is enough", "rules": ["block host:a.example only x.example,shop.example"], "url": "https://a.example/x", "site": "shop.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "except: stops the rule on that site and its subdomains", "rules": ["block host:a.example except shop.example"], "url": "https://a.example/x", "site": "www.shop.example", "type": "script", "expect": "pass" },
  { "name": "except: the rule still fires elsewhere", "rules": ["block host:a.example except shop.example"], "url": "https://a.example/x", "site": "other.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "except: is applied before only, so a site in both is excluded", "rules": ["block host:a.example only shop.example except www.shop.example"], "url": "https://a.example/x", "site": "www.shop.example", "type": "script", "expect": "pass" },
  { "name": "except: only still fires on the rest of the only site", "rules": ["block host:a.example only shop.example except www.shop.example"], "url": "https://a.example/x", "site": "shop.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "only: a site outside the only list is skipped even with except empty", "rules": ["block host:a.example only shop.example except www.shop.example"], "url": "https://a.example/x", "site": "other.example", "type": "script", "expect": "pass" },

  { "name": "precedence: off beats allow and block", "rules": ["off site:s.example", "allow host:a.example", "block host:a.example"], "url": "https://a.example/x", "site": "s.example", "type": "script", "expect": "off", "line": 1 },
  { "name": "precedence: without off, allow beats block", "rules": ["allow host:a.example", "block host:a.example"], "url": "https://a.example/x", "site": "s.example", "type": "script", "expect": "allow", "line": 1 },
  { "name": "precedence: without allow, block fires", "rules": ["block host:a.example"], "url": "https://a.example/x", "site": "s.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "precedence: a later allow still beats an earlier block", "rules": ["block host:a.example", "allow host:a.example"], "url": "https://a.example/x", "site": "s.example", "type": "script", "expect": "allow", "line": 2 },
  { "name": "precedence: a specific block cannot override a broad allow", "rules": ["allow label:adserver", "block host:adserver.example"], "url": "https://adserver.example/x", "site": "s.example", "type": "script", "expect": "allow", "line": 1 },
  { "name": "precedence: an allow that does not apply lets the block through", "rules": ["allow host:a.example only other.example", "block host:a.example"], "url": "https://a.example/x", "site": "s.example", "type": "script", "expect": "block", "line": 2 },
  { "name": "off: matches subdomains of the site", "rules": ["off site:s.example"], "url": "https://a.example/x", "site": "www.s.example", "type": "script", "expect": "off", "line": 1 },
  { "name": "off: does not match a longer first label", "rules": ["off site:s.example", "block host:a.example"], "url": "https://a.example/x", "site": "xs.example", "type": "script", "expect": "block", "line": 2 },
  { "name": "off: does not match when extra labels follow", "rules": ["off site:s.example"], "url": "https://a.example/x", "site": "s.example.net", "type": "script", "expect": "pass" },
  { "name": "off: applies to first-party requests too", "rules": ["off site:s.example"], "url": "https://s.example/x", "site": "s.example", "type": "script", "expect": "off", "line": 1 },
  { "name": "off: beats a block that has party any", "rules": ["off site:s.example", "block host:s.example party any"], "url": "https://s.example/x", "site": "s.example", "type": "script", "expect": "off", "line": 1 },

  { "name": "lowest line: two hosts, the earlier line wins", "rules": ["block host:a.example", "block host:a.example kind script"], "url": "https://a.example/x", "site": "s.example", "type": "script", "expect": "block", "line": 1 },
