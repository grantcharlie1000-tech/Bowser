  { "name": "party: allow also defaults to third party", "rules": ["allow host:a.example", "block host:a.example party any"], "url": "https://a.example/x", "site": "a.example", "type": "script", "expect": "block", "line": 2 },

  { "name": "kind: image rule does not fire for a script", "rules": ["block host:a.example kind image"], "url": "https://a.example/x", "site": "b.example", "type": "script", "expect": "pass" },
  { "name": "kind: image rule fires for an image", "rules": ["block host:a.example kind image"], "url": "https://a.example/x", "site": "b.example", "type": "image", "expect": "block", "line": 1 },
  { "name": "kind: a list of kinds fires for each member", "rules": ["block host:a.example kind xhr,font"], "url": "https://a.example/x", "site": "b.example", "type": "font", "expect": "block", "line": 1 },
