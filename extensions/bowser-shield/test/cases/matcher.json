  { "name": "party: first fires on the site itself", "rules": ["block host:a.example party first"], "url": "https://a.example/x", "site": "a.example", "type": "script", "expect": "block", "line": 1 },
  { "name": "party: first does not fire from another site", "rules": ["block host:a.example party first"], "url": "https://a.example/x", "site": "b.example", "type": "script", "expect": "pass" },
