  { "name": "labels: a host with 25 labels passes rather than walking", "rules": ["block label:adserver"], "url": "https://adserver.a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p.q.r.s.t.u.v.w.x/x", "site": "s.example", "type": "script", "expect": "pass" },
  { "name": "labels: a 25-label host passes even for a host rule", "rules": ["block host:x.example"], "url": "https://a.b.c.d.e.f.g.h.i.j.k.l.m.n.o.p.q.r.s.t.u.v.w.x.example/x", "site": "s.example", "type": "script", "expect": "pass" },
